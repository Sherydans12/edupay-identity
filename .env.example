NODE_ENV=
PORT=
DATABASE_URL=

JWT_ISSUER=
JWT_AUDIENCE=
JWT_ACCESS_TTL_SECONDS=
JWT_ALGORITHM=
JWT_KEY_ID=
JWT_PRIVATE_KEY_PATH=
JWT_PUBLIC_JWKS_PATH=
JWKS_CACHE_MAX_AGE_SECONDS=

ARGON2_MEMORY_COST=
ARGON2_TIME_COST=
ARGON2_PARALLELISM=
ARGON2_HASH_LENGTH=
ARGON2_SALT_LENGTH=

OPAQUE_TOKEN_BYTES=

# Session and abuse-control policy (secure MVP values shown; tune operationally).
REFRESH_IDLE_TTL_SECONDS=2592000
SESSION_ABSOLUTE_TTL_SECONDS=7776000
LOGOUT_ALL_REAUTH_MAX_AGE_SECONDS=600
PASSWORD_LOCK_THRESHOLD=10
PASSWORD_LOCK_SECONDS=900
RATE_LIMIT_WINDOW_SECONDS=900
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_REFRESH_MAX=60
RATE_LIMIT_INTERNAL_MAX=5000

# Server-to-server EduPay Académico authentication. Generate with at least 32 random bytes,
# encode as base64url, and keep only in server-side managed secret storage.
IDENTITY_ACADEMICO_SERVICE_TOKEN=
# Optional rotation overlap only. When set, expiry is required and must be within 24 hours.
IDENTITY_ACADEMICO_SERVICE_TOKEN_PREVIOUS=
IDENTITY_ACADEMICO_SERVICE_TOKEN_PREVIOUS_EXPIRES_AT=

# Identity-owned email delivery. Keep these values outside source control.
RESEND_API_KEY=
IDENTITY_EMAIL_FROM=EduPay Identity <no-reply@example.test>
IDENTITY_PUBLIC_BASE_URL=https://identity.example.test
# Comma-separated exact browser origins. No wildcard is accepted; leave empty to disable browser CORS.
IDENTITY_TRUSTED_WEB_ORIGINS=
# Example local-only override: IDENTITY_TRUSTED_WEB_ORIGINS=http://localhost:3001
# Keep true in production. Set false only for explicitly configured HTTP local development.
IDENTITY_COOKIE_SECURE=true
IDENTITY_REFRESH_COOKIE_SAMESITE=lax
IDENTITY_EMAIL_INVITATION_TTL_SECONDS=86400
IDENTITY_ACTIVATION_TTL_SECONDS=3600
IDENTITY_PASSWORD_RESET_TTL_SECONDS=3600
ACTIVATION_ATTEMPT_LIMIT=10
PASSWORD_MIN_LENGTH=12
OUTBOX_MAX_ATTEMPTS=5
OUTBOX_BASE_BACKOFF_SECONDS=30
# Base64-encoded 32-byte key for encrypting email payloads in the durable outbox.
IDENTITY_OUTBOX_ENCRYPTION_KEY=
