{
  "name": "@edupay/identity",
  "version": "0.1.0",
  "private": true,
  "description": "Independent identity service for the EduPay ecosystem",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@10.19.0",
  "pnpm": {
    "overrides": {
      "js-yaml@>=5.0.0 <=5.2.1": "5.2.3"
    }
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "pnpm prisma:generate && nest build",
    "dev": "pnpm prisma:generate && nest start --watch",
    "start": "node dist/main.js",
    "email:deliver": "node dist/email/worker-main.js",
    "lint": "eslint src test prisma.config.ts vitest.config.ts",
    "typecheck": "pnpm prisma:generate && tsc --noEmit",
    "test": "pnpm prisma:generate && vitest run",
    "test:unit": "pnpm prisma:generate && vitest run src",
    "test:e2e": "pnpm prisma:generate && vitest run test/application.e2e-spec.ts",
    "test:integration": "pnpm prisma:generate && vitest run test/persistence.integration-spec.ts",
    "keys:generate:dev": "node scripts/generate-development-keys.mjs",
    "contract:verify:jwks": "node scripts/verify-academico-jwks-contract.mjs",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@nestjs/common": "11.1.28",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.1.28",
    "@nestjs/platform-express": "11.1.28",
    "@nestjs/swagger": "11.4.6",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "argon2": "0.45.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "helmet": "8.3.0",
    "jose": "6.2.8",
    "pg": "8.16.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.1.28",
    "@types/express": "5.0.6",
    "@types/node": "26.2.0",
    "@types/pg": "8.16.0",
    "@types/supertest": "6.0.3",
    "eslint": "9.39.2",
    "prisma": "7.9.1",
    "supertest": "7.2.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.66.0",
    "vitest": "4.1.10"
  }
}
